{
  "name": "goddel-motors-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --include .env --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "create-owner": "tsx --env-file-if-exists=.env src/scripts/createOwner.ts",
    "seed:settings": "tsx --env-file-if-exists=.env src/scripts/seedSettings.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seedDemo.ts",
    "cleanup:orphans": "tsx --env-file-if-exists=.env src/scripts/cleanupOrphans.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-win32-x64-msvc": "^1.2.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "smtp-server": "^3.19.21",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
