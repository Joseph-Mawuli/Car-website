# Copy to `.env` for development. Set these as environment variables / secrets on
# your host in production. NEVER commit a real .env file.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database › Connect › Drivers). Required in production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/goddel-motors?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins (exact match, no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Public website URL — used in the sitemap, share pages and staff setup links
PUBLIC_SITE_URL=http://localhost:5173

# Number of reverse proxies in front of the API (e.g. 1 on Render/Railway/Fly) so
# rate limiting sees real client IPs. Use 0 when running locally.
TRUST_PROXY=0

# Random secret (32+ chars) used to hash enquiry IP addresses. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENQUIRY_IP_SALT=replace-with-a-long-random-string

# Firebase Admin SDK service account (Project settings › Service accounts › Generate key).
# Paste the private key on one line with \n for newlines, wrapped in double quotes.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Staff invitation emails. Configure SMTP for branded invites (preferred). If SMTP is
# not set, FIREBASE_WEB_API_KEY (the same value as VITE_FIREBASE_API_KEY) lets Firebase
# send its built-in "Reset your password" email instead. With neither, the Owner is
# shown the setup link to send by hand.
FIREBASE_WEB_API_KEY=
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS is then required)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address on a domain verified with your email provider
MAIL_FROM="Goddel Motors <no-reply@yourdomain.com>"

# Cloudflare R2 (R2 › Manage API tokens — Object Read & Write, scoped to one bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=goddel-motors-images
# Public bucket URL or custom domain, e.g. https://images.yourdomain.com
R2_PUBLIC_BASE_URL=

# Stop-gap photo storage before R2 is set up: STORAGE_DRIVER=mongodb keeps photos in the
# database (GridFS) and serves them from this API. Leave blank to use R2.
STORAGE_DRIVER=
# Public URL of this API (no trailing slash); required in production with STORAGE_DRIVER=mongodb
PUBLIC_API_URL=http://localhost:4000

MAX_UPLOAD_MB=12
MAX_IMAGES_PER_VEHICLE=24
