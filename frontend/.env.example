# Copy to `.env.local` for development. Every VITE_ variable is PUBLIC — it is
# embedded in the JavaScript sent to browsers. Never put database URLs, Firebase
# Admin private keys, R2 secret keys or any other secret here.

# Backend API origin (no trailing slash, no /api/v1)
VITE_API_BASE_URL=http://localhost:4000

# Public URL of this website — used for share links and password-setup redirects
VITE_SITE_URL=http://localhost:5173

# Firebase *web* app config (Project settings › General › Your apps). These are
# public identifiers, not secrets. Leave blank to disable admin sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional fallback contact details, used only if the API is unreachable.
# The real values are managed in Admin › Settings.
VITE_PUBLIC_PHONE=
VITE_PUBLIC_WHATSAPP=
VITE_PUBLIC_EMAIL=

# DEV ONLY: preview the UI with in-browser sample data (no backend needed).
# Ignored by production builds.
VITE_USE_MOCK_API=false
